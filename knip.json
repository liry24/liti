{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignoreExportsUsedInFile": true,
    "ignore": [
        "packages/*/dist/**",
        "test/fixtures/**/.nuxt/**",
        "test/fixtures/**/.void/**",
        "test/fixtures/model/**",
        "test/fixtures/integration/**"
    ],
    "workspaces": {
        ".": {
            "entry": [
                "*.config.ts",
                "scripts/*.mjs",
                "test/**/*.test.ts",
                "test/*.mjs",
                "test/*types.ts",
                "test/fixtures/**/*.{ts,vue}"
            ],
            "project": ["*.ts", "scripts/*.{ts,mjs}", "test/**/*.{ts,mjs,vue}"],
            "ignoreDependencies": ["@litijs/drizzle", "@litijs/sqlite", "@arethetypeswrong/cli", "@intlify/h3"],
            "ignoreBinaries": ["generate"]
        },
        "packages/liti": {
            "entry": [
                "src/{index,adapter,tooling,client,public-client,admin-client,descriptor,config-resolution,config,seo}.ts!",
                "src/server/index.ts!"
            ],
            "project": ["src/**/*.ts!"],
            "ignoreDependencies": ["@types/markdown-it", "@babel/parser", "jiti", "nypm", "semver", "yaml"],
            "ignoreIssues": {
                "package.json": ["optionalPeerDependencies"]
            }
        },
        "packages/model": {
            "entry": [
                "src/index.ts!",
                "src/content/index.ts!",
                "src/records/index.ts!",
                "src/records/schema.ts!",
                "src/vite/index.ts!"
            ],
            "project": ["src/**/*.ts!"]
        },
        "packages/cli": {
            "entry": ["src/index.ts!"],
            "project": ["src/**/*.ts!"]
        },
        "packages/vue": {
            "entry": ["src/{index,form,model}.ts!"],
            "project": ["src/**/*.ts!"]
        },
        "packages/nuxt": {
            "entry": [
                "src/{index,server-api}.ts!",
                "src/nuxt/server.ts!",
                "src/runtime/**/*.ts!",
                "src/devtools/{index,dock,client/app}.ts!"
            ],
            "project": ["src/**/*.ts!"]
        },
        "packages/sqlite": {
            "entry": ["src/{index,runtime,native,connection,schema,schema-source}.ts!"],
            "project": ["src/**/*.ts!"]
        },
        "packages/drizzle": {
            "entry": ["src/{index,runtime,schema,tooling}.ts!"],
            "project": ["src/**/*.ts!"],
            "ignoreDependencies": ["drizzle-kit"]
        },
        "packages/void": {
            "entry": ["src/{index,runtime,session,context,files,auth,nuxt,storage,database,schema,tooling}.ts!"],
            "project": ["src/**/*.ts!"]
        },
        "packages/ai": {
            "entry": ["src/{index,ai-sdk,void}.ts!"],
            "project": ["src/**/*.ts!"]
        },
        "packages/blog": {
            "entry": ["src/{index,vue}.ts!"],
            "project": ["src/**/*.ts!"]
        },
        "packages/test-utils": {
            "entry": ["src/{index,vitest}.ts!"],
            "project": ["src/**/*.ts!"]
        },
        "test/fixtures/vitehub": {
            "entry": [
                "auth-schema.config.ts!",
                "probe-database.ts!",
                "server/auth.ts!",
                "server/console-authorize.ts!",
                "server/databases/config.ts!",
                "server/schedules/*.ts!",
                "workarounds/*.ts!",
                "verify-*.mjs!"
            ],
            "ignoreDependencies": ["@iconify-json/lucide", "@iconify-json/ph", "nuxt", "wrangler", "vue-tsc"]
        }
    }
}
