{
    "name": "@litijs/void",
    "version": "0.0.3",
    "description": "Void runtime and resource adapters for liti",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/liry24/liti.git",
        "directory": "packages/void"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./database": {
            "types": "./dist/database.d.ts",
            "import": "./dist/database.js"
        },
        "./schema": {
            "types": "./dist/schema.d.ts",
            "import": "./dist/schema.js",
            "require": "./dist/schema.js"
        },
        "./tooling": {
            "types": "./dist/tooling.d.ts",
            "import": "./dist/tooling.js"
        },
        "./storage": {
            "types": "./dist/storage.d.ts",
            "import": "./dist/storage.js"
        },
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./runtime": {
            "types": "./dist/runtime.d.ts",
            "import": "./dist/runtime.js"
        },
        "./session": {
            "types": "./dist/session.d.ts",
            "import": "./dist/session.js"
        },
        "./context": {
            "types": "./dist/context.d.ts",
            "import": "./dist/context.js"
        },
        "./files": {
            "types": "./dist/files.d.ts",
            "import": "./dist/files.js"
        },
        "./auth": {
            "types": "./dist/auth.d.ts",
            "import": "./dist/auth.js"
        },
        "./nuxt": {
            "types": "./dist/nuxt.d.ts",
            "import": "./dist/nuxt.js"
        }
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "vp pack",
        "prepack": "bun run build",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@better-auth/drizzle-adapter": "1.7.11",
        "@litijs/sqlite": "workspace:^",
        "auth": "1.7.11",
        "drizzle-orm": "0.45.4",
        "files-sdk": "^3.1.1",
        "jiti": "^2.7.0"
    },
    "devDependencies": {
        "@nuxtjs/better-auth": "^0.3.11",
        "better-auth": "1.7.11",
        "liti": "workspace:*",
        "nitropack": "2.13.5",
        "nuxt": "4.6.2",
        "nuxt-files-sdk": "^0.3.1",
        "void": "1.1.12"
    },
    "peerDependencies": {
        "@nuxtjs/better-auth": "^0.3.11",
        "liti": "^0.0.3",
        "nuxt": "^4.6.2",
        "nuxt-files-sdk": "^0.3.1",
        "void": "1.1.12"
    },
    "peerDependenciesMeta": {
        "nuxt": {
            "optional": true
        },
        "@nuxtjs/better-auth": {
            "optional": true
        },
        "nuxt-files-sdk": {
            "optional": true
        }
    },
    "liti": {
        "id": "void",
        "apiVersion": 1,
        "kind": "adapter",
        "liti": "^0.0.3 || ^0.1.0",
        "factory": "voidAdapter",
        "config": "@litijs/void",
        "managedPeers": [
            "void"
        ]
    }
}
