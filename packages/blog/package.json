{
    "name": "@litijs/blog",
    "version": "0.0.3",
    "description": "Article models and editorial workflows for liti",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/liry24/liti.git",
        "directory": "packages/blog"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./agents": {
            "types": "./dist/agents/index.d.ts",
            "import": "./dist/agents/index.js",
            "default": "./dist/agents/index.js"
        },
        "./vue": {
            "types": "./dist/vue/index.d.ts",
            "import": "./dist/vue/index.js",
            "default": "./dist/vue/index.js"
        },
        "./nuxt": {
            "types": "./dist/nuxt/index.d.ts",
            "import": "./dist/nuxt/index.js",
            "default": "./dist/nuxt/index.js"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "vp pack",
        "prepack": "bun run build",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@litijs/model": "workspace:*",
        "@standard-schema/spec": "^1.1.0",
        "@vite-hub/blob": "https://pkg.pr.new/vite-hub/vitehub/@vite-hub/blob@24ddab7ff9885d1b5ea176b8824f6e3f1a0e3ca9",
        "@vite-hub/content": "https://pkg.pr.new/vite-hub/vitehub/@vite-hub/content@24ddab7ff9885d1b5ea176b8824f6e3f1a0e3ca9",
        "comark": "^0.8.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/markdown-it": "14.2.0",
        "nuxt": "4.6.2",
        "vite-hub": "https://pkg.pr.new/vite-hub/vitehub/vite-hub@24ddab7ff9885d1b5ea176b8824f6e3f1a0e3ca9",
        "vue": "3.6.0-rc.12"
    },
    "peerDependencies": {
        "nuxt": "^4.6.2",
        "vite-hub": "https://pkg.pr.new/vite-hub/vitehub/vite-hub@24ddab7ff9885d1b5ea176b8824f6e3f1a0e3ca9",
        "vue": "^3.5.44 || ^3.6.0-rc.2"
    },
    "peerDependenciesMeta": {
        "vite-hub": {
            "optional": true
        },
        "vue": {
            "optional": true
        },
        "nuxt": {
            "optional": true
        }
    }
}
