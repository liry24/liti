{
    "name": "@litijs/drizzle",
    "version": "0.0.3",
    "description": "Independent Drizzle SQLite adapters for liti",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/liry24/liti.git",
        "directory": "packages/drizzle"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./runtime": {
            "types": "./dist/runtime.d.ts",
            "import": "./dist/runtime.js"
        },
        "./schema": {
            "types": "./dist/schema.d.ts",
            "import": "./dist/schema.js"
        },
        "./tooling": {
            "types": "./dist/tooling.d.ts",
            "import": "./dist/tooling.js"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "vp pack",
        "prepack": "bun run build",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@litijs/sqlite": "workspace:^"
    },
    "devDependencies": {
        "@types/bun": "^1.4.4",
        "drizzle-kit": "1.0.0-rc.5",
        "drizzle-orm": "1.0.0-rc.5",
        "liti": "workspace:*"
    },
    "peerDependencies": {
        "drizzle-kit": "1.0.0-rc.5",
        "drizzle-orm": "1.0.0-rc.5",
        "liti": "^0.0.3"
    },
    "peerDependenciesMeta": {
        "drizzle-kit": {
            "optional": true
        }
    },
    "liti": {
        "id": "drizzle",
        "apiVersion": 1,
        "kind": "adapter",
        "liti": "^0.0.3 || ^0.1.0",
        "factory": "drizzle",
        "config": "@litijs/drizzle",
        "managedPeers": [
            "drizzle-orm",
            "drizzle-kit"
        ]
    }
}
