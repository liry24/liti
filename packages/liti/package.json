{
    "name": "liti",
    "version": "0.0.3",
    "description": "Nuxt integration for native ViteHub models",
    "homepage": "https://github.com/liry24/liti#readme",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/liry24/liti.git",
        "directory": "packages/liti"
    },
    "bin": {
        "liti": "./dist/cli/index.js"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./types": {
            "types": "./dist/nuxt/types.d.ts",
            "import": "./dist/nuxt/types.js",
            "default": "./dist/nuxt/types.js"
        },
        "./nuxt": {
            "types": "./dist/nuxt/index.d.ts",
            "import": "./dist/nuxt/index.js",
            "default": "./dist/nuxt/index.js"
        },
        "./server": {
            "types": "./dist/nuxt/server.d.ts",
            "import": "./dist/nuxt/server.js",
            "default": "./dist/nuxt/server.js"
        },
        "./package.json": "./package.json",
        "./module.json": "./dist/module.json"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "vp pack",
        "dev": "vp pack --watch",
        "prepack": "bun run build",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@litijs/model": "workspace:*",
        "@tanstack/vue-form": "2.0.0-alpha.3",
        "@vite-hub/auth": "0.1.0",
        "@vite-hub/content": "0.1.0",
        "h3": "^1.15.11",
        "magicast": "0.5.5",
        "nypm": "0.6.12",
        "vite-hub": "0.1.0"
    },
    "peerDependencies": {
        "nitropack": "2.13.6",
        "nuxt": "^4.6.2",
        "vue": "^3.5.44 || ^3.6.0-rc.2"
    },
    "peerDependenciesMeta": {
        "nuxt": {
            "optional": true
        },
        "vue": {
            "optional": true
        },
        "nitropack": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=24.21.0"
    }
}
