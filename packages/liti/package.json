{
    "name": "liti",
    "version": "0.0.3",
    "description": "Nuxt integration for native ViteHub models",
    "homepage": "https://github.com/liry24/liti#readme",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/liry24/liti.git",
        "directory": "packages/liti"
    },
    "bin": {
        "liti": "./dist/cli/index.js"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./types": {
            "types": "./dist/nuxt/types.d.ts",
            "import": "./dist/nuxt/types.js",
            "default": "./dist/nuxt/types.js"
        },
        "./nuxt": {
            "types": "./dist/nuxt/index.d.ts",
            "import": "./dist/nuxt/index.js",
            "default": "./dist/nuxt/index.js"
        },
        "./server": {
            "types": "./dist/nuxt/server.d.ts",
            "import": "./dist/nuxt/server.js",
            "default": "./dist/nuxt/server.js"
        },
        "./package.json": "./package.json",
        "./module.json": "./dist/module.json"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "vp pack",
        "dev": "vp pack --watch",
        "prepack": "bun run build",
        "typecheck": "tsc --noEmit -p tsconfig.rebuild.json"
    },
    "dependencies": {
        "@litijs/model": "workspace:*",
        "@tanstack/vue-form": "2.0.0-alpha.2",
        "@vite-hub/auth": "https://pkg.pr.new/vite-hub/vitehub/@vite-hub/auth@24ddab7ff9885d1b5ea176b8824f6e3f1a0e3ca9",
        "@vite-hub/content": "https://pkg.pr.new/vite-hub/vitehub/@vite-hub/content@24ddab7ff9885d1b5ea176b8824f6e3f1a0e3ca9",
        "h3": "^1.15.11",
        "magicast": "0.5.5",
        "nypm": "0.6.11",
        "vite-hub": "https://pkg.pr.new/vite-hub/vitehub/vite-hub@24ddab7ff9885d1b5ea176b8824f6e3f1a0e3ca9"
    },
    "peerDependencies": {
        "nitropack": "2.13.5",
        "nuxt": "^4.6.2",
        "vue": "^3.5.44 || ^3.6.0-rc.2"
    },
    "peerDependenciesMeta": {
        "nuxt": {
            "optional": true
        },
        "vue": {
            "optional": true
        },
        "nitropack": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=24.21.0"
    }
}
