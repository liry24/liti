{
    "name": "liti",
    "version": "0.1.0",
    "description": "Runtime-first, schema-driven site administration for Nuxt",
    "homepage": "https://github.com/liry24/liti#readme",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/liry24/liti.git",
        "directory": "packages/liti"
    },
    "bin": {
        "liti": "./dist/cli.mjs"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        "./adapter": {
            "types": "./dist/adapter.d.ts",
            "import": "./dist/adapter.js"
        },
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./nuxt": {
            "types": "./dist/nuxt.d.ts",
            "import": "./dist/nuxt.js"
        },
        "./vue": {
            "types": "./dist/vue.d.ts",
            "import": "./dist/vue.js"
        },
        "./config": {
            "types": "./dist/config.d.ts",
            "import": "./dist/config.js"
        },
        "./package.json": "./package.json",
        "./module.json": "./dist/module.json",
        "./internal/runtime/tasks/publish-due": {
            "types": "./dist/runtime/tasks/publish-due.d.ts",
            "import": "./dist/runtime/tasks/publish-due.js"
        },
        "./internal/runtime/tasks/sync-assets": {
            "types": "./dist/runtime/tasks/sync-assets.d.ts",
            "import": "./dist/runtime/tasks/sync-assets.js"
        },
        "./internal/runtime/tasks/asset-gc": {
            "types": "./dist/runtime/tasks/asset-gc.d.ts",
            "import": "./dist/runtime/tasks/asset-gc.js"
        },
        "./internal/config-resolution": {
            "types": "./dist/config-resolution.d.ts",
            "import": "./dist/config-resolution.js"
        },
        "./internal/runtime/context": {
            "types": "./dist/runtime/context.d.ts",
            "import": "./dist/runtime/context.js"
        },
        "./internal/runtime/presentation": {
            "types": "./dist/runtime/presentation.d.ts",
            "import": "./dist/runtime/presentation.js"
        },
        "./internal/runtime/tasks": {
            "types": "./dist/runtime/tasks.d.ts",
            "import": "./dist/runtime/tasks.js"
        },
        "./internal/nuxt/server": {
            "types": "./dist/nuxt/server.d.ts",
            "import": "./dist/nuxt/server.js"
        },
        "./internal/adapter": {
            "types": "./dist/adapter.d.ts",
            "import": "./dist/adapter.js"
        },
        "./internal/client": {
            "types": "./dist/client.d.ts",
            "import": "./dist/client.js"
        },
        "./internal/server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.js"
        },
        "./internal/model": {
            "types": "./dist/model.d.ts",
            "import": "./dist/model.js"
        },
        "./internal/form": {
            "types": "./dist/form.d.ts",
            "import": "./dist/form.js"
        },
        "./internal/seo": {
            "types": "./dist/seo.d.ts",
            "import": "./dist/seo.js"
        },
        "./client": {
            "types": "./dist/public-client.d.ts",
            "import": "./dist/public-client.js"
        },
        "./server": {
            "types": "./dist/server.d.ts",
            "import": "./dist/server.js"
        },
        "./internal/admin-client": {
            "types": "./dist/admin-client.d.ts",
            "import": "./dist/admin-client.js"
        },
        "./internal/descriptor": {
            "types": "./dist/descriptor.d.ts",
            "import": "./dist/descriptor.js"
        },
        "./internal/runtime/public-handler": "./dist/runtime/public-handler.js",
        "./internal/runtime/management-handler": "./dist/runtime/management-handler.js",
        "./internal/runtime/devtools-snapshot": "./dist/runtime/devtools-snapshot.js",
        "./internal/runtime/nitro2": "./dist/runtime/nitro2.js",
        "./internal/runtime/composables": {
            "types": "./dist/runtime/composables.d.ts",
            "import": "./dist/runtime/composables.js"
        },
        "./internal/runtime/tasks/rebuild-search": {
            "types": "./dist/runtime/tasks/rebuild-search.d.ts",
            "import": "./dist/runtime/tasks/rebuild-search.js"
        },
        "./internal/runtime/seo": {
            "types": "./dist/runtime/seo.d.ts",
            "import": "./dist/runtime/seo.js"
        },
        "./tooling": {
            "types": "./dist/tooling.d.ts",
            "import": "./dist/tooling.js"
        },
        "./nuxt/server": {
            "types": "./dist/server-api.d.ts",
            "import": "./dist/server-api.js"
        },
        "./internal/runtime/action-handler": "./dist/runtime/action-handler.js"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "vp pack",
        "dev": "vp pack --watch",
        "prepack": "bun run build",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@babel/parser": "^7.29.9",
        "@noble/hashes": "2.4.0",
        "@standard-schema/spec": "^1.1.0",
        "@types/markdown-it": "^14.1.2",
        "comark": "^0.7.0",
        "comark-content": "^0.4.1",
        "jiti": "^2.7.0",
        "nypm": "^0.6.10",
        "rou3": "^1.0.0",
        "semver": "^7.8.5",
        "yaml": "^2.9.1"
    },
    "peerDependencies": {
        "@nuxtjs/i18n": "^10.6.0",
        "@nuxtjs/robots": "^7.0.2",
        "@nuxtjs/sitemap": "^9.1.0",
        "@takumi-rs/core": "^2.16.2",
        "@takumi-rs/wasm": "^2.16.2",
        "nuxt": "^4.6.1",
        "nuxt-llms": "^0.2.0",
        "nuxt-og-image": "^7.0.7",
        "nuxt-schema-org": "^7.0.1",
        "nuxt-seo-utils": "^9.0.1",
        "nuxt-site-config": "^5.0.3",
        "vue": "^3.5.44 || ^3.6.0-rc.2"
    },
    "peerDependenciesMeta": {
        "nuxt": {
            "optional": true
        },
        "vue": {
            "optional": true
        },
        "@nuxtjs/i18n": {
            "optional": true
        },
        "@nuxtjs/robots": {
            "optional": true
        },
        "@nuxtjs/sitemap": {
            "optional": true
        },
        "nuxt-llms": {
            "optional": true
        },
        "nuxt-og-image": {
            "optional": true
        },
        "nuxt-schema-org": {
            "optional": true
        },
        "nuxt-seo-utils": {
            "optional": true
        },
        "nuxt-site-config": {
            "optional": true
        },
        "@takumi-rs/core": {
            "optional": true
        },
        "@takumi-rs/wasm": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=24.21.0"
    }
}
