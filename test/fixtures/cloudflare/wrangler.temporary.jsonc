{
    "$schema": "../../../node_modules/wrangler/config-schema.json",
    "name": "liti-d1-temporary-test",
    "main": "worker.ts",
    "compatibility_date": "2026-09-14",
    "alias": {
        "@aws-sdk/client-s3": "./unused-aws.ts",
        "@aws-sdk/lib-storage": "./unused-aws.ts",
        "@aws-sdk/s3-presigned-post": "./unused-aws.ts",
        "@aws-sdk/s3-request-presigner": "./unused-aws.ts",
    },
    "compatibility_flags": ["nodejs_compat"],
    "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "liti-test-assets" }],
    "d1_databases": [
        {
            "binding": "LITI_DB",
            "database_name": "liti-temporary-test",
            "migrations_dir": "./.data/wrangler-migrations",
        },
    ],
}
