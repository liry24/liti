{
    "name": "liti-workspace",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "build": "bun --filter liti build && bun --filter '@litijs/*' build",
        "check": "bun run format:check && bun run lint && bun run workspace:check && bun run unused && bun run typecheck && bun run test && bun run build && bun run test:nuxt && bun run test:cloudflare && bun run package:check && bun run test:packed",
        "deps:update": "taze",
        "format": "vp fmt . --write",
        "format:check": "vp fmt . --check",
        "lint": "vp lint .",
        "lint:fix": "vp lint . --fix",
        "unused": "knip && knip --production",
        "workspace:check": "sherif -i drizzle-orm -i drizzle-kit",
        "preview:package": "pkg-pr-new publish ./packages/liti ./packages/sqlite ./packages/drizzle ./packages/void ./packages/ai ./packages/blog ./packages/test-utils --bun --no-compact --previewVersion --peerDeps --comment=update",
        "package:check": "node scripts/check-packages.mjs",
        "test": "vp test run",
        "test:bun-sqlite": "bun test test/adapter.test.ts -t 'sqlite domain storage conformance'",
        "test:cloudflare": "node test/cloudflare-local.mjs && node test/native-stream.mjs cloudflare && node test/nuxt-d1.mjs",
        "test:nuxt": "vp test run --config vitest.nuxt.config.ts && node test/nuxt-build.mjs && node test/native-stream.mjs node",
        "test:packed": "node test/isolated-consumers.mjs && node test/packed-consumers.mjs",
        "typecheck": "bun --filter '*' typecheck && tsc --noEmit -p test/tsconfig.json",
        "bundle:size": "bun run build && bun scripts/measure-bundles.mjs --workspace-root .",
        "test:vitehub": "node test/vitehub.mjs",
        "test:vitehub:cloudflare": "node test/vitehub.mjs --cloudflare",
        "test:model:native": "node test/model-native.mjs"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@better-auth/drizzle-adapter": "1.7.12",
        "@litijs/ai": "workspace:*",
        "@litijs/blog": "workspace:*",
        "@litijs/drizzle": "workspace:*",
        "@litijs/model": "workspace:*",
        "@litijs/sqlite": "workspace:*",
        "@litijs/test-utils": "workspace:*",
        "@litijs/void": "workspace:*",
        "@nuxt/test-utils": "4.3.4",
        "@nuxtjs/better-auth": "0.3.11",
        "@nuxtjs/i18n": "^10.6.0",
        "@nuxtjs/robots": "^7.0.2",
        "@nuxtjs/sitemap": "^9.1.0",
        "@takumi-rs/core": "^2.17.1",
        "@takumi-rs/wasm": "^2.17.1",
        "@types/node": "^26.6.5",
        "@vue/compiler-sfc": "3.6.0-rc.12",
        "ai": "7.0.150",
        "better-auth": "1.7.12",
        "cf": "1.0.0-beta.20",
        "comark": "^0.8.1",
        "db0": "^0.4.1",
        "drizzle-kit": "0.31.11",
        "drizzle-orm": "0.45.4",
        "files-sdk": "^3.1.1",
        "h3": "^1.15.11",
        "jiti": "^2.7.0",
        "knip": "6.42.1",
        "liti": "workspace:*",
        "nitropack": "2.13.5",
        "nuxt": "4.6.2",
        "nuxt-files-sdk": "^0.3.1",
        "nuxt-llms": "^0.3.0",
        "nuxt-og-image": "^7.0.7",
        "nuxt-schema-org": "^7.0.1",
        "nuxt-seo-utils": "^9.0.1",
        "nuxt-site-config": "^5.0.3",
        "nypm": "^0.6.11",
        "pathe": "^2.0.3",
        "pkg-pr-new": "0.0.91",
        "publint": "^0.3.25",
        "sherif": "1.13.0",
        "tailwindcss": "^4.3.3",
        "taze": "^21.3.0",
        "typescript": "^7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
        "vite-plus": "1.3.0",
        "vitest": "5.0.5",
        "void": "1.2.1",
        "vue": "3.6.0-rc.12",
        "wrangler": "^4.152.0",
        "zod": "^4.6.7"
    },
    "overrides": {
        "auth": "1.7.12",
        "better-auth": "1.7.12",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
        "vitest": "5.0.5",
        "vue": "3.6.0-rc.12"
    },
    "engines": {
        "node": ">=24.21.0"
    },
    "packageManager": "bun@1.4.4",
    "patchedDependencies": {
        "nitropack@2.13.5": "patches/nitropack@2.13.5.patch",
        "@vite-hub/content@https://pkg.pr.new/vite-hub/vitehub/@vite-hub/content@24ddab7ff9885d1b5ea176b8824f6e3f1a0e3ca9": "patches/vitehub-content-publication-24ddab7.patch"
    }
}
