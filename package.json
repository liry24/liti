{
    "name": "liti-workspace",
    "private": true,
    "workspaces": [
        "packages/model",
        "packages/liti",
        "packages/blog"
    ],
    "type": "module",
    "scripts": {
        "build": "bun --filter @litijs/model build && bun --filter liti build && bun --filter @litijs/blog build",
        "check": "bun run format:check && bun run lint && bun run workspace:check && bun run unused && bun run typecheck && bun run test && bun run build && bun run test:nuxt && bun run test:cloudflare && bun run package:check && bun run test:packed",
        "deps:update": "taze",
        "format": "vp fmt . --write",
        "format:check": "vp fmt . --check",
        "lint": "vp lint .",
        "lint:fix": "vp lint . --fix",
        "unused": "knip && knip --production",
        "workspace:check": "sherif",
        "preview:package": "pkg-pr-new publish ./packages/model ./packages/liti ./packages/blog --bun --no-compact --previewVersion --peerDeps --comment=update",
        "package:check": "node scripts/check-packages.mjs",
        "test": "vp test run",
        "test:cloudflare": "node test/vitehub.mjs --cloudflare",
        "test:nuxt": "node test/model-native.mjs --nuxt",
        "test:packed": "node test/isolated-consumers.mjs && node test/packed-consumers.mjs",
        "typecheck": "bun --filter '*' typecheck && tsc --noEmit -p test/tsconfig.json",
        "bundle:size": "bun run build && bun scripts/measure-bundles.mjs --workspace-root .",
        "test:vitehub": "node test/vitehub.mjs",
        "test:vitehub:cloudflare": "node test/vitehub.mjs --cloudflare",
        "test:model:native": "node test/model-native.mjs",
        "test:liti:native": "node test/model-native.mjs --nuxt",
        "test:model:vite": "node test/model-vite.mjs"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@litijs/blog": "workspace:*",
        "@litijs/model": "workspace:*",
        "@types/node": "^26.6.5",
        "@vue/compiler-sfc": "3.6.0-rc.12",
        "drizzle-orm": "0.45.4",
        "knip": "6.42.1",
        "liti": "workspace:*",
        "nitropack": "2.13.5",
        "nuxt": "4.6.2",
        "nypm": "0.6.11",
        "pkg-pr-new": "0.0.91",
        "publint": "^0.3.25",
        "sherif": "1.13.0",
        "taze": "^21.3.0",
        "typescript": "^7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
        "vite-plus": "1.3.0",
        "zod": "^4.6.7"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
        "vitest": "5.0.5",
        "vue": "3.6.0-rc.12"
    },
    "engines": {
        "node": ">=24.21.0"
    },
    "packageManager": "bun@1.4.4",
    "patchedDependencies": {
        "nitropack@2.13.5": "patches/nitropack@2.13.5.patch",
        "@vite-hub/content@https://pkg.pr.new/vite-hub/vitehub/@vite-hub/content@24ddab7ff9885d1b5ea176b8824f6e3f1a0e3ca9": "patches/vitehub-content-publication-24ddab7.patch",
        "@vite-hub/agent@https://pkg.pr.new/vite-hub/vitehub/@vite-hub/agent@24ddab7ff9885d1b5ea176b8824f6e3f1a0e3ca9": "patches/vitehub-agent-24ddab7.patch",
        "vite-hub@https://pkg.pr.new/vite-hub/vitehub/vite-hub@24ddab7ff9885d1b5ea176b8824f6e3f1a0e3ca9": "patches/vitehub-nuxt-24ddab7.patch",
        "@vite-hub/blob@https://pkg.pr.new/vite-hub/vitehub/@vite-hub/blob@24ddab7ff9885d1b5ea176b8824f6e3f1a0e3ca9": "patches/vitehub-blob-h3-types-24ddab7.patch",
        "nuxt@4.6.2": "patches/nuxt@4.6.2-async-data.patch"
    }
}
