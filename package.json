{
    "name": "liti-workspace",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "type": "module",
    "scripts": {
        "build": "bun --filter liti build && bun --filter '@litijs/*' build",
        "check": "bun run format:check && bun run lint && bun run workspace:check && bun run unused && bun run typecheck && bun run test && bun run build && bun run test:nuxt && bun run test:cloudflare && bun run package:check && bun run test:packed",
        "deps:update": "taze",
        "format": "vp fmt . --write",
        "format:check": "vp fmt . --check",
        "lint": "vp lint .",
        "lint:fix": "vp lint . --fix",
        "unused": "knip && knip --production",
        "workspace:check": "sherif",
        "preview:package": "pkg-pr-new publish ./packages/liti --bun --no-compact --previewVersion --comment=update",
        "package:check": "publint packages/liti && attw --pack packages/liti --profile esm-only --exclude-entrypoints ./internal/runtime/composables ./internal/runtime/seo",
        "test": "vp test run",
        "test:bun-sqlite": "bun test test/adapter.test.ts -t 'sqlite domain storage conformance'",
        "test:cloudflare": "node test/cloudflare-local.mjs && node test/native-stream.mjs cloudflare && node test/nuxt-d1.mjs",
        "test:nuxt": "vp test run --config vitest.nuxt.config.ts && node test/nuxt-build.mjs && node test/native-stream.mjs node",
        "test:packed": "node test/packed-consumers.mjs",
        "typecheck": "bun --filter '*' typecheck && tsc --noEmit -p test/tsconfig.json",
        "bundle:size": "bun run build && bun scripts/measure-bundles.mjs --package-root packages/liti"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@better-auth/drizzle-adapter": "1.7.11",
        "@litijs/drizzle": "workspace:*",
        "@litijs/sqlite": "workspace:*",
        "@litijs/void": "workspace:*",
        "@nuxt/test-utils": "4.3.4",
        "@nuxtjs/better-auth": "^0.3.11",
        "@nuxtjs/i18n": "^10.6.0",
        "@nuxtjs/robots": "^7.0.2",
        "@nuxtjs/sitemap": "^9.1.0",
        "@takumi-rs/core": "^2.17.0",
        "@takumi-rs/wasm": "^2.17.0",
        "@types/node": "^26.6.5",
        "@vue/compiler-sfc": "3.6.0-rc.12",
        "ai": "7.0.145",
        "better-auth": "1.7.11",
        "cf": "1.0.0-beta.18",
        "comark": "^0.7.0",
        "db0": "^0.4.1",
        "drizzle-kit": "0.31.11",
        "drizzle-orm": "0.45.4",
        "files-sdk": "^3.1.1",
        "h3": "^1.15.11",
        "jiti": "^2.7.0",
        "knip": "6.42.1",
        "liti": "workspace:*",
        "nitropack": "2.13.5",
        "nuxt": "4.6.2",
        "nuxt-files-sdk": "^0.3.1",
        "nuxt-llms": "^0.2.0",
        "nuxt-og-image": "^7.0.7",
        "nuxt-schema-org": "^7.0.1",
        "nuxt-seo-utils": "^9.0.1",
        "nuxt-site-config": "^5.0.3",
        "pathe": "^2.0.3",
        "pkg-pr-new": "0.0.91",
        "publint": "^0.3.25",
        "sherif": "1.13.0",
        "tailwindcss": "^4.3.3",
        "taze": "^21.3.0",
        "typescript": "^7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
        "vite-plus": "1.3.0",
        "vitest": "5.0.5",
        "void": "1.1.12",
        "vue": "3.6.0-rc.12",
        "wrangler": "^4.151.2",
        "zod": "^4.6.7"
    },
    "overrides": {
        "auth": "1.7.11",
        "better-auth": "1.7.11",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
        "vitest": "5.0.5",
        "vue": "3.6.0-rc.12"
    },
    "engines": {
        "node": ">=24.21.0"
    },
    "packageManager": "bun@1.4.3"
}
